// corrected solution according to leetcode condtion of overflow
class Solution {
public:
    string shiftingLetters(string s, vector<int>& shifts) {
        long long n = shifts.size();
        vector<int> suffix(n);
        int sum=0;
        for(int i = n-1 ; i >=0 ; i-- ){
            sum = (sum + shifts[i]) % 26;
            suffix[i] = sum;
        }
        for(int i = 0 ; i<n ; i++){
            s[i]='a' + (s[i] - 'a' + suffix[i]) % 26;
        }
    return s;
    }
};
