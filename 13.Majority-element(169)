class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n =nums.size();
        unordered_map<int,int>counts;
        for(int val : nums)
        {
            counts[val]++;
            if(counts[val] > n/2){
                return val;
            }
        }
        return -1;
    }
};
