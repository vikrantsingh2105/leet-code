class Solution {
public:
    vector<int> shuffle(vector<int>& nums, int n) {
      int m = nums.size();
    
      vector<int> ans(m);
        
        for(int i=0 ; i<m ; i++)
        {
                if(i%2==0)
                {
                    ans[i]=nums[i/2];
                }
                else
                {
                    ans[i]=nums[n+(i/2)];
                }
        }
        return ans;
    }
};        
        
