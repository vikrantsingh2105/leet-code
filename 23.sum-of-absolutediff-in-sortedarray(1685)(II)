class Solution {
public:
    vector<int> getSumAbsoluteDifferences(vector<int>& nums) {
        int n = nums.size();
        int lps = 0;
        vector<int> ans;

        int ts = 0;

        for(int i = 0; i<n; i++){
            ts += nums[i];
        }

        for (int i = 0; i < n; i++) {
            int ls = nums[i] * i - lps;
            lps += nums[i];
            int rs = ts - lps - nums[i] * (n - i - 1);
            int sum = ls + rs;

            ans.push_back(sum);
        }

        return ans;
    }
};
