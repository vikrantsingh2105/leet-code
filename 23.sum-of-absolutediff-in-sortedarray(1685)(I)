class Solution {
public:
    vector<int> getSumAbsoluteDifferences(vector<int>& nums) {
        int n = nums.size();
        vector<int>ans(n,0);
        for(int i = 0 ; i < n ; i++){
            for(int j=0 ; j<n ; j++){
                ans[i] += abs(nums[i]-nums[j]);
            }
        }
        return ans;
    }
};
