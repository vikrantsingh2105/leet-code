class Solution {
public:
    vector<int> createTargetArray(vector<int>& nums, vector<int>& index) {
        int n=nums.size();

        vector<int> target;

        for(int i=0 ; i<n ; i++)
        {
            int pos=index[i];
            int val=nums[i];

            target.push_back(0);
            
            for(int j = target.size()-1 ; j > pos ; j--)
            {
                target[j] = target[j-1];
            }

            target[pos]=val;
        }
        return target;
    }
};
