//Time complexity = O(n^2)
class Solution {
public:
    vector<int> productExceptSelf(vector<int>& nums) {
        int n=nums.size();
        vector<int> ans(n);
        for(int i = 0 ; i < n ; i++ ){
            int prod=1;
                for(int j = 1 ; j<n ; j++){
                    prod *= nums[(i + j) % n ];
                }
             ans[i]=prod;
        }
        return ans;
    }
};
